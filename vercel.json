{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "rewrites": [
                {
                    "source": "/signup",
                    "destination": "/index.html"
                },
                {
                    "source": "/signin",
                    "destination": "/index.html"
                }
            ]
        },
        "backend": {
            "root": "backend",
            "framework": "express",
            "entrypoint": "app.js"
        }
    },

    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/assets/:path*",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}